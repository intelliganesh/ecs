<?xml version="1.0" encoding="utf-8" ?>

<Statements>
	<sql sqlid="1" help="GET EMPLOYEE BENEFITS BY CLEINT ">
		<![CDATA[
     select EMP.Client_Id ,EMP.EE_ID,EM.EE_SORT_NAME,BEN_PLAN_ID,Ben_Plan_Desc,Payee_id ,Ben_Plan_Type_Code,Prem_PEO_Amt,sum(B_EE_DEDUCT) dedeamnt,Prem_PEO_Amt-Contrib_EE_Total_Amt employercontr
from export.EMPLOYEE_COM EMP
Inner Join export.EMPLOYEE_BEN_DETAIL BEN on EMP.Client_ID=BEN.Client_ID and EMP.EE_ID=BEN.EE_ID 
Inner Join export.EMPLOYEE_PER EM on EM.U2_id=EMP.EE_ID 
Inner Join export.BENEFIT_PLANS BP on BP.u2_id =BEN.BEN_PLAN_ID 
Inner Join export.EPV EP on EP.EE_ID=EMP.EE_ID and EP.Client_ID=EMP.Client_ID 
Inner Join export.EPV_BEN_PLAN EPV on EPV.u2_id=EP.u2_id and BEN.BEN_PLAN_ID=EPV.B_PLAN_ID 
where EMP.Client_id=@CLIENT_ID  and BP.Bill_Code in ('DEN' ,'LIFE','LTD','MED','STD','VIS') 
and YEAR(PAY_DATE)=YEAR(GETDATE()) and MONTH(PAY_DATE)=MONTH(GETDATE())-1
and BEN_COV_DETAIL_EFF_DATE=(select max( BEN_COV_DETAIL_EFF_DATE)
from export.EMPLOYEE_BEN_DETAIL BEN1 where BEN.Client_ID=BEN1.Client_id and BEN.EE_ID=BEN1.EE_ID and BEN.BEN_PLAN_ID=BEN1.BEN_PLAN_ID)

group by EMP.Client_Id ,EMP.EE_ID,EM.EE_SORT_NAME,BEN_PLAN_ID,Ben_Plan_Desc,Payee_id,Ben_Plan_Type_Code,Prem_PEO_Amt,Prem_PEO_Amt-Contrib_EE_Total_Amt

      ]]>

	</sql>

	<sql sqlid="2" help="GET ALL EMPLOYEE BENEFITS BY CLIENT AND EMPLOYEE ID">
		<![CDATA[
   SELECT [Id]
      ,EBR.[Client_ID]
      ,EBR.[EE_ID]
	  ,EP.EE_SORT_NAME
      ,[BEN_YEAR]
      ,[BEN_MONTH] BENMONTH
      ,case when BEN_MONTH=0 then ''
	  else DATENAME(MM,cAST([BEN_MONTH] as varchar)+'/01/'+cast([BEN_YEAR] as varchar)) end BEN_MONTH
      ,EBR.[Insurance_Class_Id]
      ,BEN_PLAN_ID
	  ,BEN_PLAN_DESC
      ,EBR.[Payee_ID]
      ,[Ben_Plan_Type_Code]
      ,[Prem_PEO_Amt]
      ,B_EE_DEDUCT [EE_CNTB_AMT]
      ,[total_prem]-B_EE_CONTRIB [ER_CNTB_AMT]
      ,[Action_Type]
      ,[Adjust_AMT]
      ,[Net_AMT]
  

  FROM [Syd].[dbo].[EMPLOYEE_BENEFIT_RECONCILED] EBR
  INNER JOIN [Prism].export.Employee_Per EP ON EP.U2_ID = EBR.EE_ID
  LEFT JOIN [prism].export.BENEFIT_PLANS BP on BP.BEN_PLAN_ID_pk= EBR.BEN_PLAN_ID
 left join [Syd].[dbo].prism_voucher_info pv on EBR.client_id = pv.client_id and ebr.ee_id = pv.ee_id and ebr.ben_month=pv.mnth and ebr.ben_year = pv.yr 
  and ebr.ben_plan_id = pv.b_plan_id
  WHERE EBR.Client_ID=@CLIENT_ID
  and EBR.EE_ID='@EMP_ID'
  and EBR.Insurance_Class_Id = '@BEN_CLASS_ID'
  and (EBR.BEN_YEAR=@IYEAR OR 'Y'='@FLAG')
  --and EBR.Payee_ID NOT IN ('NOT')
  order by 5 desc,6 desc
   ]]>
	</sql>
	<sql sqlid="3" help="INSERT EMPLOYEE RECONCILED DETAILS">
		<![CDATA[
    INSERT INTO [Syd].[dbo].[EMPLOYEE_BENEFIT_RECONCILED]
           ([Client_ID]
           ,[EE_ID]
           ,[BEN_PLAN_ID]
           ,[Payee_ID]
           ,[Ben_Plan_Type_Code]
           ,[Prem_PEO_Amt]
           ,[EE_CNTB_AMT]
           ,[ER_CNTB_AMT]
           ,[Action_Type]
           ,[Insurance_Class_Id]
           ,[BEN_YEAR]
           ,[BEN_MONTH]
           )
     VALUES(
			@CLIENT_ID
           ,'@EMP_ID'
           ,'@BEN_PLAN_ID'
           ,'@PAYEE_ID'
           ,'@BEN_PLAN_TYPE_CODE'
           ,@PREM_PEO_AMT
           ,@EE_CNTB_AMT
           ,@ER_CNTB_AMT
           ,'@ACTION'
           ,'@Insurance_Class_Id'
           ,@BEN_YEAR,
           @BEN_MONTH
           )
    ]]>
	</sql>
	<sql sqlid="4" help="BENEFIT_CLASS_CODES/TYPE">
		<![CDATA[
     select u2_id,CLASS_DESC from export.BENEFIT_CLASS where u2_id NOT IN ('B')
    ]]>
	</sql>
	<sql sqlid="5" help="GET BENEFIT PLANS">
		<![CDATA[
    select u2_Id,BEN_PLAN_DESC from export.BENEFIT_PLANS
    ]]>
	</sql>
	<sql sqlid="6" help="GET BENEFIT CARRIERS/PayeeID">
		<![CDATA[
    select distinct BP.Payee_ID,
                    PC.Payee_Name 
                    from export.BENEFIT_PLANS BP
                    inner join export.Payee_Codes PC on PC.Payee_ID = BP.Payee_ID
    ]]>
	</sql>
	<sql sqlid="7" help="GET PREMIUM FOR LOAD">
		<![CDATA[
    select 
	EMP.Client_Id,
	EMP.EE_ID,
	EM.EE_SORT_NAME,
	YEAR(GETDATE()) BEN_YEAR,
	MONTH(GETDATE())-3 BEN_MONTH,
	BEN_PLAN_ID,
	Ben_Plan_Desc,
	BP.Insurance_Class_Id,
	Payee_id ,
	Ben_Plan_Type_Code,
	Prem_PEO_Amt,
	sum(B_EE_DEDUCT) dedeamnt,
	Prem_PEO_Amt-Contrib_EE_Total_Amt employercontr
from export.EMPLOYEE_COM EMP
Inner Join export.EMPLOYEE_BEN_DETAIL BEN on EMP.Client_ID=BEN.Client_ID and EMP.EE_ID=BEN.EE_ID 
Inner Join export.EMPLOYEE_PER EM on EM.U2_id=EMP.EE_ID 
Inner Join export.BENEFIT_PLANS BP on BP.u2_id =BEN.BEN_PLAN_ID 
Inner Join export.EPV EP on EP.EE_ID=EMP.EE_ID and EP.Client_ID=EMP.Client_ID 
Inner Join export.EPV_BEN_PLAN EPV on EPV.u2_id=EP.u2_id and BEN.BEN_PLAN_ID=EPV.B_PLAN_ID 
where 
 BP.Insurance_Class_Id='@BEN_CLASS'
and Payee_Id = '@PAYEE_ID'
and BEN_PLAN_ID='@BEN_PLAN_ID'
and BP.Bill_Code in ('DEN' ,'LIFE','LTD','MED','STD','VIS') 
and YEAR(PAY_DATE)=YEAR(GETDATE()) and MONTH(PAY_DATE)=MONTH(GETDATE())-3
and BEN_COV_DETAIL_EFF_DATE=(select max( BEN_COV_DETAIL_EFF_DATE)
from export.EMPLOYEE_BEN_DETAIL BEN1 where BEN.Client_ID=BEN1.Client_id and BEN.EE_ID=BEN1.EE_ID and BEN.BEN_PLAN_ID=BEN1.BEN_PLAN_ID)
group by EMP.Client_Id ,EMP.EE_ID,EM.EE_SORT_NAME,BEN_PLAN_ID,Ben_Plan_Desc,BP.Insurance_Class_Id,Payee_id,Ben_Plan_Type_Code,Prem_PEO_Amt,Prem_PEO_Amt-Contrib_EE_Total_Amt
    ]]>
	</sql>

	<sql sqlid="8" help="Update the BENEFITS RECONCILED">
		<![CDATA[
      UPDATE [Syd].[dbo].[EMPLOYEE_BENEFIT_RECONCILED]
      SET 
	    Prem_PEO_AMT =@Prem_PEO_AMT,
	    Adjust_AMT = @Adjust_Amt,
      ACTION_TYPE='@ACTION',
      USERID='@IN_USER',
      timestamp_up=GETDATE()
	    where Id=@Id
    ]]>
	</sql>

	<sql sqlid="9" help="GET DISTINCT YEARS DROPDOWN">
		<![CDATA[
      select distinct YEAR(Pay_Date) YR from export.EPV
      where YEAR(PAY_DATE) BETWEEN YEAR(GETDATE())-10 and YEAR(GETDATE())+1
	  union
	  select year(getdate())+1 YR
    ]]>
	</sql>

	<sql sqlid="10" help="GET DISTINCT MONTH DROPDOWN">
		<![CDATA[
     select distinct MONTH(PAY_DATE) MO, SUBSTRING(DATENAME(MM,PAY_DATE),0,4) MON from export.EPV
     order by 1
    ]]>
	</sql>
	<sql sqlid="11" help="GET PLAN TYPES BASED ON YEAR AND MONTH">
		<![CDATA[
   select u2_id,CLASS_DESC from export.BENEFIT_CLASS Bc where ( NOT EXISTS 
	 (select 1 from [Syd].dbo.[EMPLOYEE_BENEFIT_RECONCILED] RC where BEN_YEAR=@OPT_YEAR and BEN_MONTH=@OPT_MONTH
	 and Bc.u2_id=Rc.Insurance_Class_id) or 'Y'='@OPT_CHECK'   ) and u2_id NOT IN ('B')
  ]]>
	</sql>

	<sql sqlid="12" help="GET CLIENT BEN PLANS">
		<![CDATA[
       select DISTINCT 
	  BEN_PLAN_ID,
	  bp.BEN_PLAN_DESC,
	  BEN_PLAN_TYPE_CODE,
	  PAYEE_ID 
	  from prism.export.client_benefits CB 
      INNER JOIN  prism.export.benefit_plans bp on bp.u2_id = cb.ben_plan_id
      LEFT JOIN prism.export.BENEFIT_RULES_CONTRIB_RULES BR ON BR.CLIENT_ID_1 = CB.CLIENT_ID AND BR.BEN_PLAN_ID_1=CB.BEN_PLAN_ID
      where client_id = @CLIENT_ID
      and Insurance_class_id = '@BEN_CLASS_ID'
      AND BILL_CODE NOT LIKE '%SDI%'
      AND PAYEE_ID NOT IN ('NOT')
      --AND BEN_PLAN_TYPE_CODE !=''
    ]]>
	</sql>
	<sql sqlid="13" help="INSERT MISSING BENEFIT OF EMPLOYEE ">
		<![CDATA[
      INSERT INTO  [Syd].[dbo].[EMPLOYEE_BENEFIT_RECONCILED]
      (
	         [Client_ID]
            ,[EE_ID]
            ,[BEN_YEAR]
            ,[BEN_MONTH]
            ,[Insurance_Class_Id]
            ,[BEN_PLAN_ID]
            ,[Payee_ID]
            ,[Ben_Plan_Type_Code]
            ,[Prem_PEO_Amt]
            ,[EE_CNTB_AMT]
            ,[ER_CNTB_AMT]
            ,[Action_Type]
            ,[Adjust_AMT]
            ,[Net_AMT]
            ,[USERID]
            ,[timestamp_up]
	        )
	        VALUES(
	        @CLIENT_ID,
	        '@EMP_ID',
	        @BEN_YEAR,
	        @BEN_MONTH,
	        '@CLASS_ID',
	        '@BEN_PLAN_ID',
	        '@PAYEE_ID',
	        '@Ben_Plan_Type_Code',
	        @Prem_PEO_Amt,
	        0,0,'NC',0,0
	        ,'@USERID',GETDATE()
	        )

    ]]>
	</sql>

	<sql sqlid="14" help="INSERT INTO MASS MUTUAL ROW">
		<![CDATA[
    
    INSERT INTO [Syd].dbo.syd_mass_mutual_trans
    ( 
       [RAW_DATA]
      ,[FILEID]
    )
    VALUES(
	    '@ROW_DATA',
	    '@FILEID'		
    )
    ]]>
	</sql>

	<sql sqlid="15" help="READ ALL CASE GENERATORS">
		<![CDATA[
     SELECT [AUDIT_ID]
      ,[AUDIT_NAME]
      ,[EMAIL_HEADER]
      ,[EMAIL_BODY]
      ,[SQL_TEXT]
      ,[FREQUENCY]
	  ,FREQ_NAME,JOB_STATUS
  FROM [Syd].[dbo].[SYD_AUDIT_INFO] SAI
  INNER JOIN [Syd].dbo.SYD_AUDIT_FREQ_DEF FD ON FD.FREQ_FLAG = SAI.FREQUENCY
    ]]>
	</sql>

	<sql sqlid="16" help="READ ALL FREQUENCY FOR AUDIT">
		<![CDATA[
    SELECT [FREQ_SEQ_NO]
      ,[FREQ_NAME]
      ,[FREQ_FLAG]
  FROM [Syd].[dbo].[SYD_AUDIT_FREQ_DEF]
    ]]>
	</sql>

	<sql sqlid="17" help="INSERT AUDIT CASE">
		<![CDATA[
    INSERT INTO [Syd].[dbo].[SYD_AUDIT_INFO](
      [AUDIT_NAME]
          ,[EMAIL_HEADER]
          ,[EMAIL_BODY]
          ,[SQL_TEXT]
          ,[FREQUENCY]
          ,[USERID]
          ,[JOB_STATUS]
          ,[SQL_KEY]
          ,[AUDIT_DESC]
      )
      VALUES(
	    '@AUD_NAME',
	    '@AUD_MAIL_SUB',
	    '@AUD_MAIL_BODY',
	    '@SQL_STMT',
	    '@FREQ_FLAG',
      '@USERID',
      @JSTATUS,
      '@SQL_KEY',
      '@AUD_DESC'
      )
      SELECT SCOPE_IDENTITY()
    ]]>
	</sql>


	<sql sqlid="18" help="UPDATE AUDIT CASE">
		<![CDATA[
     UPDATE [Syd].[dbo].[SYD_AUDIT_INFO]
	SET
	[AUDIT_NAME]='@AUD_NAME',
    [EMAIL_HEADER]='@AUD_MAIL_SUB',
    [EMAIL_BODY]='@AUD_MAIL_BODY',
    [SQL_TEXT]='@SQL_STMT',
    [FREQUENCY]='@FREQ_FLAG',
    [USERID] ='@USERID',
    [JOB_STATUS]='@JSTATUS',
    [SQL_KEY]='@SQL_KEY',
    [AUDIT_DESC]='@AUD_DESC'
 where AUDIT_ID=@AUD_ID
    ]]>
	</sql>

	<sql sqlid="19" help="READ ALL NOTIFIED TO USERS">
		<![CDATA[
    SELECT 
       [NOTIFYTO_ID]
      ,[AUDIT_ID]
      ,[NOTIFY_NAME]
      ,[NOTIFY_TO_MAIL]
      ,[NOTIFY_CC_MAIL]
  FROM [Syd].[dbo].[SYD_AUDIT_NOTIFY_INFO] WHERE AUDIT_ID=@AUD_ID
    ]]>
	</sql>

	<sql sqlid="20" help="INSERT NOTIFIED TO USER">
		<![CDATA[
    INSERT INTO [Syd].[dbo].[SYD_AUDIT_NOTIFY_INFO]
    (
      [AUDIT_ID]
      ,[NOTIFY_NAME]
      ,[NOTIFY_TO_MAIL]
      ,[NOTIFY_CC_MAIL]
    )
    VALUES(
      @AUD_ID,
      '@NOTIFY_NAME',
      '@NOTIFY_TO_MAIL',
      '@NOTIFY_CC_MAIL'
    )
    ]]>
	</sql>

	<sql sqlid="21" help="UPDATE NOTIFIED TO USER">
		<![CDATA[
    UPDATE [Syd].[dbo].[SYD_AUDIT_NOTIFY_INFO]
    SET
      [NOTIFY_NAME]='@NOTIFY_NAME',
      [NOTIFY_TO_MAIL]='@NOTIFY_TO_MAIL',
      [NOTIFY_CC_MAIL]='@NOTIFY_CC_MAIL'
    WHERE AUDIT_ID=@AUD_ID
    ]]>
	</sql>

	<sql sqlid="22" help="READ CASE GENERATORS BY ID">
		<![CDATA[
     SELECT SAI.[AUDIT_ID]
      ,[AUDIT_NAME]
      ,[AUDIT_DESC]
      ,[EMAIL_HEADER]
      ,[EMAIL_BODY]
      ,[SQL_TEXT]
      ,[FREQUENCY]
	  ,FREQ_NAME
    ,JOB_STATUS
    ,SQL_KEY
	,NOTIFY_CC_MAIL
	,NOTIFY_TO_MAIL
  FROM [Syd].[dbo].[SYD_AUDIT_INFO] SAI
  INNER JOIN [Syd].dbo.SYD_AUDIT_FREQ_DEF FD ON FD.FREQ_FLAG = SAI.FREQUENCY
  LEFT JOIN [Syd].dbo.SYD_AUDIT_NOTIFY_INFO NI ON NI.AUDIT_ID = SAI.AUDIT_ID
  WHERE SAI.AUDIT_ID=@AUD_ID
    ]]>
	</sql>

	<sql sqlid="23" help="UPDATE AUDIT DATA TBL AFTER MAIL">
		<![CDATA[
    UPDATE [Syd].dbo.SYD_AUDIT_data
    SET 
        AUDIT_FLAG='Y'
    where MASTER_AUDIT_ID=@AUD_ID AND AUDIT_FLAG='N'
    ]]>
	</sql>

	<sql sqlid="24" help="READ ALL RECORDKEEPER S">
		<![CDATA[
 	select FileID,
   Client_ID		,
   File_Name		,
   Delimiter_Typ	,
   Cust_Cal		from  RET_TB_RECORDKEEPER_INFO order by FileID desc 
    ]]>
	</sql>
	<sql sqlid="25" help="READ  RECORDKEEPER By Id">
		<![CDATA[
  select FileID,
  Client_ID		,
  File_Name		,
  Delimiter_Typ	,
  Cust_Cal		from  RET_TB_RECORDKEEPER_INFO where FileID=@FileID
    ]]>
	</sql>
	<sql sqlid="26" help="DELETE RECORDKEEPER By Id">
		<![CDATA[
    BEGIN TRANSACTION;
    SAVE TRANSACTION MySavePoint;
    BEGIN TRY
    DELETE FROM RET_TB_RECORDKEEPER_INFO WHERE FileID IN (@FileID)
    DELETE from [dbo].[RET_TB_RECORDKEEPER_FILE_DETAIL] where FileID in (@FileID)
    COMMIT TRANSACTION 
    END TRY
    BEGIN CATCH
    IF @@TRANCOUNT > 0
    BEGIN
    ROLLBACK TRANSACTION MySavePoint; 
    END
    END CATCH
    ]]>
	</sql>

	<sql sqlid="27" help="READ ALL RECORDKEEPER FILE DETAIL">
		<![CDATA[
    select FileID,
    Type_Of_Record ,
    Column_Name,
    Column_Sequence,
    Max_length,
    Mapping_Column,
    Start_Position,
    Default_flag from [dbo].[RET_TB_RECORDKEEPER_FILE_DETAIL] WHERE FileID=@FileID
    ]]>
	</sql>

	<sql sqlid="28" help="READ  RECORDKEEPER FILE DETAIL By ID,Type_Of_Record and Column_Sequence">
		<![CDATA[
    select FileID,
    Type_Of_Record ,
    Column_Name,
    Column_Sequence,
    Max_length,
    Mapping_Column,
    Start_Position,
    Default_flag from [dbo].[RET_TB_RECORDKEEPER_FILE_DETAIL] where FileID=@FileID and Type_Of_Record='@Type_Of_Record' and Column_Sequence=@Column_Sequence
    ]]>
	</sql>
	<sql sqlid="29" help="DELETE RECORDKEEPER FILE DETAIL By ID,Type_Of_Record and Column_Sequence">
		<![CDATA[
   DELETE from [dbo].[RET_TB_RECORDKEEPER_FILE_DETAIL] where FileID in (@FileID) and Type_Of_Recordin ('@Type_Of_Record') and Column_Sequence in (@Column_Sequence)
    ]]>
	</sql>
	<sql sqlid="30" help="for getting table columns">
		<![CDATA[
  
    SELECT [mapping_column]
      ,[mapping_column_desc]
      ,[mapping_column_dt]
  FROM  [dbo].[rjob_mapping_column]
    ]]>
	
  </sql>  
  <sql sqlid="31" help="Save Query">
    <![CDATA[
 INSERT INTO [dbo].[rjob_query]
           ([jobid]
           ,[recttype]
           ,[Query]
           ,Conditions
           ,[Sort_Order])
     VALUES
           (@jobid,
           '@recttype',
           '@Query',
           '@conditionalStmt',
           '@sortOrder')
    ]]>
	</sql>
	<sql sqlid="32" help="Get File Type">
		<![CDATA[
select * from [dbo].[rjob_file_typ]
]]>
	</sql>
	<sql sqlid="33" help="Get Format">
		<![CDATA[
SELECT [jobformat],[jobformat]+' - '+[jobformat_desc] as jobdesc FROM [dbo].[rjobformat] where jobformattype='@jobformattype'  
  union all
SELECT [jobformat],[jobformat]+' - '+[jobformat_desc] as jobdesc FROM [dbo].[rjobformat] where jobformattype='all'    

]]>
	</sql>

	<sql sqlid="34" help="Get frequency">
		<![CDATA[
select shcdperiod as frequency  from [dbo].[rjob_job_schd_master] where shcdday is  null
union  all
select shcdday as frequency  from [dbo].[rjob_job_schd_master] where shcdperiod is  null
]]>
	</sql>

	<sql sqlid="35" help="Save file_detail">
		<![CDATA[
INSERT INTO [dbo].[rjob_file_detail]
           ([jobid]
           ,[jobclientcolumn]
           ,[jobfieldmapping]
           ,[jobdefaultvalue]
           ,[jobformat]
           ,[jobrectype]
           ,[startposition]
           ,[field_len]
           ,[DataSetNo]
           ,[ColSeqNo])
     VALUES
           (@jobid
           ,'@jobclientcolumn'
           ,'@jobfieldmapping'
           ,'@jobdefaultvalue'
           ,'@jobformat'
           ,'@jobrectype'
           ,@startposition
           ,@field_len,@datasetNo,@colSeqNo)

]]>
	</sql>
	<sql sqlid="36" help="Save file info">
		<![CDATA[


INSERT INTO [dbo].[rjob]
           ([jobdesc]
           ,[jobfilename]
           ,[jobstatus]
           ,[joblastmodified]
           ,[joblastrun],[filetype],[ismerge],[mergeemail],[includeHeader],[FileNameFormat],[isEnabled],[StoreResults],[enddate])
     VALUES
           ('@jobdesc',
			'@jobfilename',
			'@jobstatus',
			GETDATE(),
			GETDATE(),'@filetype',@ismerge, '@mergeemail',@includeHRecord,'@fileNameFormat','@isEnabled','@StoreResult','@enddate')
      SELECT SCOPE_IDENTITY()

]]>
	</sql>

	<sql sqlid="37" help="Save file Client Details">
		<![CDATA[


 INSERT INTO [dbo].[rjob_client_detail]
  ([jobid]
  ,[jobclientid]
  ,[jobemailind])
  VALUES
  (@jobid
  ,@jobclientid
  ,'@jobemailind')


]]>
	</sql>

	<sql sqlid="38" help="Save file Client sched Details">
		<![CDATA[


 INSERT INTO [dbo].[rjob_schedule_info]
  ([jobid]
  ,[jobName]
  ,[startDateTime]
  ,[dayInterval]
  ,[weekInterval]
  ,[rbJobTypeChk]
  ,[ScheduleType]
  ,[MonthlyWeekNo]
  ,[ScheduleWeek],[MonthlyDate],
   [schedule_hr]
      ,[schedule_min]
      ,[schedules_session]
  )
  VALUES
  (@jobid
  ,'@jobName'
  ,CONVERT(DATETIME, '@startDateTime')
  ,@dayInterval
  ,@weekInterval
  ,'@rbJobTypeChk'
  ,'@ScheduleType'
  ,'@MonthlyWeekNo'
  ,'@ScheduleWeek','@MonthlyDate',
  '@schedule_hr','@schedule_min','@schedule_session'
  
  )


]]>
	</sql>

	<sql sqlid="50" help="INSERT JOB HISTORY DATA">
		<![CDATA[
         delete from      [dbo].[rjob_history] where [Job_Id]=  @jobid

 INSERT INTO [dbo].[rjob_history]
  ([Job_Id]
      ,[Job_Create_Date]
      ,[Job_Last_Trigger_Date]
      ,[Job_Next_Trigger_Date]
      ,[Job_Last_Status]
      ,[Job_Last_Message]
      ,[Job_Update_Date])
  VALUES
  (@jobid
  ,GETDATE()
  ,CONVERT(DATETIME, '@LAST_TRIGGER_DATE')
  ,CONVERT(DATETIME, '@NEXT_TRIGGER_DATE')
  ,'@STATUS'
  ,'@STAT_MSG'
  ,GETDATE()
  )


]]>
	</sql>
	<sql sqlid="51" help="UPDATE JOB HISTORY DATA">
		<![CDATA[
     UPDATE [dbo].[rjob_history]
      SET [Job_Last_Trigger_Date]=GETDATE(),
      [Job_Next_Trigger_Date]=GETDATE(),
      [Job_Last_Status]='@STATUS',
      [Job_Last_Message]='@STAT_MSG',
      [Job_Update_Date]=GETDATE()
    WHERE job_id=@JOB_ID	  
    ]]>
	</sql>

	<sql sqlid="52" help="UPDATE MANUAL JOB HISTORY DATA">
		<![CDATA[
     UPDATE [dbo].[rjob_history]
      SET [Job_Last_Trigger_Date]=GETDATE(),
      [Job_Last_Status]='@STATUS',
      [Job_Last_Message]='@STAT_MSG',
      [Job_Update_Date]=GETDATE()
    WHERE job_id=@JOB_ID	  
    ]]>
	</sql>

	<sql sqlid="53" help="Get Formats All">
		<![CDATA[
SELECT [jobformat],[jobformat]+' - '+[jobformat_desc] as jobdesc,[jobformattype] FROM [dbo].[rjobformat]   

]]>
	</sql>
	<sql sqlid="54" help="INSERT FILE SORT DETAILS">
		<![CDATA[
    INSERT INTO [dbo].[rjob_file_sorting_details]
  (
	job_id
    ,sort_order
    ,mapping_column
  )
  VALUES(
  @jobid,
  @order,
 '@mapping'
  )
    ]]>
	</sql>
	<sql sqlid="55" help="INSERT FILE Conditions DETAILS">
		<![CDATA[
    INSERT INTO [dbo].[rjob_file_condition_details]
  (
	    job_id
      ,mapping_column
      ,condition_symbol
      ,condition_value
  )
  VALUES(
  @jobid,
  '@mapping',
 '@Symbol',
 '@val'
  )
    ]]>
	</sql>




	<sql sqlid="42" help="Get file Client Details">
		<![CDATA[
SELECT RJ.jobid
      ,[jobdesc]
      ,[jobfilename]
      ,[jobstatus]
      ,[joblastmodified]
      ,case when (case when joblastrun> ISNULL(job_last_trigger_Date,'01/01/1900') then joblastrun
	  else Job_Last_Trigger_Date end)='01/01/1900' then '' else (case when joblastrun> ISNULL(job_last_trigger_Date,'01/01/1900') then joblastrun
	  else Job_Last_Trigger_Date end) end
	  joblastrun
	  ,case when RSI.ScheduleWeek =0 then 'Sunday'
			when RSI.ScheduleWeek=1 then 'Monday'
			when RSI.ScheduleWeek=2 then 'Tuesday'
			when RSI.ScheduleWeek=3 then 'Wednesday'
			when RSI.ScheduleWeek=4 then 'Thursday'
			when RSI.ScheduleWeek=5 then 'Friday'
			when RSI.ScheduleWeek=6 then 'Saturday' 
			else '' end as runday
	  ,CAST(RSI.schedule_hr as varchar)+':'+case when schedule_min=0 then '00' else cast(schedule_min as varchar) end +' '+RSI.schedules_session runtime
	  ,case when RSI.ScheduleType='D' then 'Daily'
			when RSI.ScheduleType='W' then 'Weekly'
			when RSI.ScheduleType='B' then 'Bi-Weekly'
			when RSI.ScheduleType='M' then 'Monthly'
			when RSI.ScheduleType='MD' then 'Monthly'
			else '' end ScheduleType
      ,[filetype]
      ,[ismerge]
      ,[isEnabled]
	  ,case when ISNULL(isEnabled,0)=1 then 'Yes' else 'No' end as IsActive
	  ,RH.Job_Last_Status,
	  RH.Job_Last_Message,
	  CONVERT(VARCHAR,RHD.START_DATE,101) as Start_Date,
   CONVERT(VARCHAR,RHD.END_DATE,101) as End_Date
  FROM [dbo].[rjob] RJ
  inner join [dbo].[rjob_schedule_info] RSI on RSI.jobid=RJ.jobid
  left join [dbo].[rjob_history] RH on RH.Job_Id=RJ.jobid
  left join (Select top 1 [Id]
      ,[Job_Id]
      ,[Flag]
      ,[Start_Date]
      ,[End_Date]
      ,[Pay_Date]
	  from [dbo].rjob_history_details 
	  order by Id desc) RHD ON RHD.Job_Id=RJ.jobid 
     where isEnabled=1
	order by isEnabled desc
]]>
	</sql>

	<sql sqlid="43" help="Get file Client Details">
		<![CDATA[
 --SELECT [id]
 -- ,[client_name]
  --,[client_email]
  --FROM [dbo].[Client]
  select cast(Client_ID as decimal) as id,CAST(Client_ID as varchar)+' - '+Client_DBA_Name as client_name from prism.export.Client_Details
where Client_Status_Code!='T'
order by 1,2
  
]]>
	</sql>
