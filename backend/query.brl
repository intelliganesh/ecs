      ,DocUrlName
  FROM [dbo].[SYD_BM_CLIENT_DOCUMENTS] BCD
  inner join [Syd].[dbo].[SYD_BM_INS_CLASS] BC on BCD.Plan_Type=BC.CLASS_CODE
  where Client_Id='@clientId'
    ]]>
	</sql>

	<sql sqlid="81" help="GET CLIENT DOC BY Id">
		<![CDATA[
        SELECT [Document_Id]
      ,[File_Name]
      ,[File_Description]
      ,[Plan_Type]
      ,[Plan_Id]
      ,[Client_Id]
      ,Document_Type
      ,[Effective_Date]
      ,[IsActive]
      ,DocUrlName
  FROM [dbo].[SYD_BM_CLIENT_DOCUMENTS]
  where Document_Id='@docId'
    ]]>
	</sql>

	<sql sqlid="82" help="INSERT CLIENT DOC">
		<![CDATA[
         INSERT INTO [dbo].[SYD_BM_CLIENT_DOCUMENTS]
([File_Name]
      ,[File_Description]
      ,[Plan_Type]
      ,[Plan_Id]
      ,[Client_Id]
      ,Document_Type
      ,[Effective_Date]
      ,[IsActive]
      ,[DocUrlName])
	  VALUES('@fileName','@fileDesc','@planType','@planId','@clientId','@docType','@effDt','@status','@docUrl')
    ]]>
	</sql>

	<sql sqlid="83" help="UPDATE CLIENT DOC">
		<![CDATA[
        UPDATE [dbo].[SYD_BM_CLIENT_DOCUMENTS]
     SET [File_Name]='@fileName'
      ,[File_Description]='@fileDesc'
      ,[Plan_Type]='@planType'
      ,[Plan_Id]='@planId'
      ,[Client_Id]='@clientId'
      ,[Document_Type]='@docType'
      ,[Effective_Date]='@effDt'
      ,[IsActive]='@status'
      ,DocUrlName='@docUrl'
  where Document_Id=@docId and Client_id='@clientId'
    ]]>
	</sql>
	<sql sqlid="84" help="DELETE CLIENT DOC">
		<![CDATA[
        DELETE FROM [dbo].[SYD_BM_CLIENT_DOCUMENTS] where Document_Id=@docId  
    ]]>
	</sql>
	<sql sqlid="85" help="GET CLIENT SUMMARY">
		<![CDATA[
    SELECT CD.U2_ID,
CLIENT_DBA_NAME,
case when bill_template_code='ASO' then 'ASO' else 'PEO' end as CLIENT_TYPE,
CSC.CLIENT_STATUS_CLASS_DESC as STATUS,
DOC_COUNT,
COUNT(SB.PLAN_ID) PLAN_COUNT
FROM PRISM.EXPORT.CLIENT_DETAILS CD
INNER JOIN PRISM.[EXPORT].[CLIENT_STATUS_CODES] CSC ON CSC.U2_ID=CD.CLIENT_STATUS_CODE
LEFT JOIN (Select Client_ID ,count(DOCUMENT_ID) DOC_COUNT from DBO.SYD_BM_CLIENT_DOCUMENTS GROUP BY CLIENT_ID)  SD ON SD.CLIENT_ID=CD.U2_ID
LEFT JOIN DBO.SYD_BM_PLAN_INFO SB ON SB.CLIENT_ID=CD.CLIENT_ID
GROUP BY CD.U2_ID,DOC_COUNT,
CLIENT_DBA_NAME,case when bill_template_code='ASO' then 'ASO' else 'PEO' end,
CSC.CLIENT_STATUS_CLASS_DESC
order by 3,2
    ]]>
	</sql>
	<sql sqlid="86" help="GET PLAN TYPES">
		<![CDATA[
     Select CLASS_CODE Plan_type,CLASS_DESC 
  from [Syd].[dbo].[SYD_BM_INS_CLASS] 
    ]]>
	</sql>
	<sql sqlid="87" help="GET PLAN Id">
		<![CDATA[
    Select distinct Plan_id from [dbo].[SYD_BM_PLAN_INFO]
    ]]>
	</sql>

	<sql sqlid="88" help="CLIENT DETAIL">
		<![CDATA[
   SELECT CD.[U2_ID]
,[CLIENT_ADDR_CITY]
,[CLIENT_ADDR_LINE_1]
,[CLIENT_ADDR_LINE_2]
,[CLIENT_ADDR_STATE]
,[CLIENT_ADDR_ZIP_CODE]
,[CLIENT_ADDR_ZIP_SUFFIX]
,[CLIENT_DBA_NAME]
,[CLIENT_EMAIL]
,[CLIENT_FAX_NO]
,CD.CLIENT_ID
,[CLIENT_LEGAL_NAME]
,[CLIENT_PHONE_NO]
,CSC.CLIENT_STATUS_CLASS_DESC as STATUS
,'' [CLIENT_TERM_DESC]
,[CLIENT_TERM_REASON_CODE]
,CONVERT(VARCHAR,CONTRACT_DATE,101) CONTRACT_DATE
,'' [CONTRACT_DETAIL_CODE]
, '' [CONTRACT_END_DATE]
,'' [CONTRACT_RENEWAL_TERM]

,[EMAIL_ADDRESS]
,'' [OWNER_NAME]
,'' [OWNER_PHONE_NO]
, '' [OWNER_TITLE]

,[WC_POLICY_CODE]
,[WC_POLICY_EFF_DATE]
,BC.CLIENT_GROUP_ID
,BC.OnBoarding_Responsibility
,BC.Cobra_Administrator
,CN.Client_Note
FROM [PRISM].[EXPORT].[CLIENT_DETAILS] CD
INNER JOIN PRISM.[EXPORT].[CLIENT_STATUS_CODES] CSC ON CSC.U2_ID=CD.CLIENT_STATUS_CODE
LEFT JOIN PRISM.EXPORT.CLIENT_DETAILS_NOTES CN ON CN.u2_id=CD.u2_id and CN.CLIENT_DETAILS_NOTES_ID like '%-1'
LEFT JOIN prism.export.HRP_CONTACTS HRC ON HRC.CLIENT_ID=CD.U2_ID AND CONTACT_TYPE ='BENEFITS'
LEFT JOIN syd.[dbo].[SYD_BM_CLIENT_INFO] BC ON BC.Client_Id=CD.Client_Id
where CD.U2_ID='@clientId'
    ]]>
	</sql>
	<sql sqlid="89" help="UPSERT CLIENT_INFO">
		<![CDATA[
      if not exists (select Client_Id from SYD_BM_CLIENT_INFO where Client_Id='@clientId')
    INSERT INTO [dbo].[SYD_BM_CLIENT_INFO]
  (Client_Id,Client_Group_Id,OnBoarding_Responsibility,Cobra_Administrator)
  VALUES('@clientId','@groupId','@onBoardResp','@cobraAdmin'); 
else
    UPDATE dbo.SYD_BM_CLIENT_INFO
  SET 
  Client_Group_Id='@groupId',
  OnBoarding_Responsibility='@onBoardResp',
  Cobra_Administrator='@cobraAdmin'
  where Client_Id='@clientId' 
  ]]>
	</sql>
	<sql sqlid="90" help="GET CLIENT PLAN INFO">
		<![CDATA[
  SELECT [Plan_id]
      ,[Plan_name]
	  ,case when plan_status='A' then 'Active' else 'Terminated' end as planStatus
      ,CLASS_DESC Plan_type
      ,BPI.Carrier_id
	  ,''Carrier_Name
      ,case when isnull(renewal_month,0)=0 then
'To be updated' else
datename(month,cast(renewal_month as varchar)+'/'+'01'+'/'+'1900') end as Renewal_month
      ,[Enroll_month]
      ,[Enroll_day]
      ,[Broker_id]
      ,[TPA_id]
      ,[Carrier_contact_id]
      ,[EDI_Active]
      ,case when Ben_Enroll_Act='Y' then 'Yes' else 'No' end as Ben_Enroll_Act
      ,[Plan_Notes]
      ,[Client_ID]
  FROM [dbo].[SYD_BM_PLAN_INFO] BPI
  inner join [dbo].[SYD_BM_INS_CLASS] IC on IC.CLASS_CODE=BPI.PLAN_TYPE
  where Client_ID = '@clientId'
    ]]>
	</sql>
	<sql sqlid="91" help="GET CLINET PLAN INFO BY PLAN ID AND CLIENT ID">
		<![CDATA[
    SELECT [Plan_id]
      ,[Plan_name]
      ,[Plan_type]
      ,[Carrier_id]
	  ,case when isnull(renewal_month,0)=0 then
'To be updated' else
datename(month,cast(renewal_month as varchar)+'/'+'01'+'/'+'1900') end as Renewal_monthDesc
      ,Renewal_month
      ,[Enroll_month]
      ,[Enroll_day]
      ,[Broker_id]
      ,[TPA_id]
      ,[Carrier_contact_id]
      ,case when EDI_Active='0' then 'N' else 'Y' end as EDI_Active 
      ,[Ben_Enroll_Act]
      ,[Plan_Notes]
      ,BPI.Client_ID
	  ,Client_DBA_NAME
      ,[Plan_Status]
      ,[ESC_Master_Plan]
      ,[Agent_Id]
      ,CONVERT(VARCHAR,[Plan_Effective_Date],101) Plan_Effective_Date
      ,CONVERT(VARCHAR,[Plan_End_Date],101) Plan_End_Date
	  ,Policy_No
	  ,Passback
	  ,IC.CLASS_DESC
	  ,[Record_Keeper_Id]
      ,[Financial_Advisor_Id]
      ,[EB_Recon]
  FROM [Syd].[dbo].[SYD_BM_PLAN_INFO] BPI
  inner join prism.export.Client_Details CD on CD.u2_id=BPI.Client_ID
  inner join [Syd].dbo.SYD_BM_INS_CLASS IC on IC.CLASS_CODE=BPI.Plan_Type
   where BPI.Client_ID='@clientId' and Plan_id='@planId'
    ]]>
	</sql>
	<sql sqlid="92" help="UPDATE PLAN INFO">
		<![CDATA[
      UPDATE [dbo].[SYD_BM_PLAN_INFO]
   SET
		[Plan_id]='@planId'
      ,[Plan_name]='@planName'
      ,[Plan_type]='@planType'
      ,[Carrier_id]=@carrierId
      ,[Renewal_month]='@renewalDate'
	  ,Enroll_month='@enrollMonth'
	  ,Enroll_day='@enrollDay'
      ,[Broker_id]=@brokerId
      ,[TPA_id]=@tpaId
      ,[Record_Keeper_Id]=@rkId
      ,[Financial_Advisor_Id]=@finId
      ,[Carrier_contact_id]=@carrierContactId
      ,[Plan_Notes]='@planNotes'
      ,[Client_ID]='@clientId'
      ,[Plan_Status]='@planStatus'
      ,[Agent_Id]='@agentId'
	  ,[Policy_No]='@policyNo'
	  ,[Passback]='@passBack'
   WHERE Client_ID='@clientId' and Plan_id='@planId'
    ]]>
	</sql>
	<sql sqlid="93" help="GET BM CARRIERS">
