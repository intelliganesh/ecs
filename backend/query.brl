  FROM [dbo].[SYD_BM_CARRIERS]
    ]]>
	</sql>
	<sql sqlid="94" help="INSERT CLIENT PLAN INFO MISC">
		<![CDATA[
		  if not exists (select Client_Id,Plan_Id from [Syd].[dbo].SYD_BM_PLAN_MISC where Client_Id='@sClient_Id' and Plan_Id='@sPlan_Id')
    INSERT INTO [Syd].[dbo].[SYD_BM_PLAN_MISC]
  (
  [Offered]
      ,[Cafeteria_Plan]
      ,[Med_Allowed]
      ,[Den_Allowed]
      ,[Vis_Allowed]
      ,[Non_Full_Time_Allowed]
      ,[Benefit_Amt]
      ,[Benefit_Max]
      ,[Benefit_Frequency]
      ,[Plan_Details]
      ,[ESC_Role_Activity]
      ,[Active_Plan]
      ,[Client_Id]
      ,[Plan_Id]
	  ,[No_of_Loans]
	  ,[Has_Roth]
	  ,[Plan_Year]
	  ,[Elimination_Period]
	  ,[Wage_Based_On_W2]
	  ,[Group_Number]
  )
  VALUES(
  @bOffered
      ,@bCafeteria_Plan
      ,@bMed_Allowed
      ,@bDen_Allowed
      ,@bVis_Allowed
      ,@bNon_Full_Time_Allowed
      ,'@sBenefit_Amt'
      ,'@sBenefit_Max'
      ,'@sBenefit_Frequency'
      ,'@sPlan_Details'
      ,'@sESC_Role_Activity'
      ,@bActive_Plan
      ,'@sClient_Id'
      ,'@sPlan_Id'
	  ,'@iNoOfLoans'
	  ,@bHasRoth
	  ,'@sPlanYear'
	  ,'@sEliminationPeriod'
	  ,@bwageBasedOnW2
	  ,'@sGroup_Number'
  ); 
else
    UPDATE [Syd].[dbo].[SYD_BM_PLAN_MISC]
  SET 
  [Offered]=@bOffered
      ,[Cafeteria_Plan]=@bCafeteria_Plan
      ,[Med_Allowed]=@bMed_Allowed
      ,[Den_Allowed]=@bDen_Allowed
      ,[Vis_Allowed]=@bVis_Allowed
      ,[Non_Full_Time_Allowed]=@bNon_Full_Time_Allowed
      ,[Benefit_Amt]='@sBenefit_Amt'
      ,[Benefit_Max]='@sBenefit_Max'
      ,[Benefit_Frequency]='@sBenefit_Frequency'
      ,[Plan_Details]='@sPlan_Details'
      ,[ESC_Role_Activity]='@sESC_Role_Activity'
      ,[Active_Plan]=@bActive_Plan
      ,[Client_Id]='@sClient_Id'
      ,[Plan_Id]='@sPlan_Id'
	  ,[No_of_Loans]='@iNoOfLoans'
	  ,[Has_Roth]=@bHasRoth
	  ,[Plan_Year]='@sPlanYear'
	  ,[Elimination_Period]='@sEliminationPeriod'
	  ,[Wage_Based_On_W2]=@bwageBasedOnW2
	  ,[Group_Number]='@sGroup_Number'	  
  where Client_Id='@sClient_Id' and Plan_Id='@sPlan_Id' 
		]]>
	</sql>
